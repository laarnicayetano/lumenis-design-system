{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.tsx",
    "ui_kits/**/*.ts",
    "ui_kits/**/*.tsx",
    "build/**/*.ts",
    "build/**/*.tsx",
    "guidelines/**/*.tsx",
    "scripts/**/*.ts"
  ]
}
