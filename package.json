{
  "name": "lumenis-design-system",
  "version": "1.5.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write \"**/*.{js,jsx,mjs}\" --print-width 100",
    "check": "npm run validate && npm run typecheck && npm run check:cards && npm run check:links",
    "validate": "node scripts/validate.mjs",
    "typecheck": "tsc --noEmit",
    "check:cards": "node scripts/check-cards.mjs",
    "check:links": "node scripts/check-markdown-links.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3"
  }
}
